# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact details shown on the site. Leave blank to keep the visible placeholders.
# WhatsApp number: digits only, with country code, e.g. 923001234567
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OFFICE_ADDRESS=

# Email (recommended). When these three are set, each enquiry is emailed to CONTACT_NOTIFY_EMAIL
# and the visitor gets a confirmation email. For Gmail: host smtp.gmail.com, port 465, and use an
# "App password" (Google Account > Security > 2-Step Verification > App passwords), NOT the normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "TRT Associate <SMTP_USER>".
MAIL_FROM=
# Optional. Defaults to the company email shown on the site.
CONTACT_NOTIFY_EMAIL=

# Server-side only. Fallback if SMTP is not set: /api/contact forwards validated enquiries (JSON POST).
# Works with a Zapier/Make webhook, Formspree-style endpoint, or your own API.
# If unset, the API returns 503 and the form tells the visitor to use email/WhatsApp.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent to the webhook as "Authorization: Bearer <token>".
CONTACT_WEBHOOK_TOKEN=
