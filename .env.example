# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact details shown on the site. Leave blank to keep the visible placeholders.
# WhatsApp number: digits only, with country code, e.g. 923001234567
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OFFICE_ADDRESS=

# Server-side only. Where /api/contact forwards validated enquiries (JSON POST).
# Works with a Zapier/Make webhook, Formspree-style endpoint, or your own API.
# If unset, the API returns 503 and the form tells the visitor to use email/WhatsApp.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent to the webhook as "Authorization: Bearer <token>".
CONTACT_WEBHOOK_TOKEN=
